{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:benchcad:3d2d:prediction:0.2",
  "title": "General STEP/DXF submission claims; never trusted evidence by themselves",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "units", "input_sha256", "drawing_sha256", "features", "views", "dimensions", "structure", "auxiliary"],
  "properties": {
    "schema_version": {"const": "benchcad-3d2d-prediction/0.2"},
    "case_id": {"type": "string", "minLength": 1},
    "units": {"const": "mm"},
    "input_sha256": {"$ref": "#/$defs/hash"},
    "drawing_sha256": {"$ref": "#/$defs/hash"},
    "features": {"type": "array", "maxItems": 512, "items": {"$ref": "#/$defs/feature"}},
    "views": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/view"}},
    "dimensions": {"type": "array", "maxItems": 512, "items": {"$ref": "#/$defs/dimension"}},
    "structure": {"type": "array", "maxItems": 512, "items": {"$ref": "#/$defs/structure"}},
    "auxiliary": {"type": "array", "maxItems": 20000, "items": {"type": "object", "additionalProperties": false,
      "required": ["drawing_ref", "role"], "properties": {"drawing_ref": {"$ref": "#/$defs/drawing_ref"}, "role": {"enum": ["centerline", "text"]}}}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "vec2": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
    "vec3": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
    "drawing_ref": {"description": "Modelspace handle, optional nested INSERT handles, then leaf entity handle; no bare block names.",
      "type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "string", "pattern": "^[0-9A-F]+$"}},
    "refs": {"type": "array", "maxItems": 20000, "items": {"$ref": "#/$defs/drawing_ref"}},
    "geometry_ref": {"type": "object", "additionalProperties": false, "required": ["kind", "fingerprint"],
      "properties": {"kind": {"enum": ["face", "edge"]}, "fingerprint": {"$ref": "#/$defs/hash"}}},
    "feature": {"type": "object", "additionalProperties": false, "required": ["id", "type", "geometry_refs"],
      "properties": {"id": {"type": "string", "minLength": 1}, "type": {"type": "string", "minLength": 1},
        "geometry_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/geometry_ref"}},
        "center": {"$ref": "#/$defs/vec3"}, "axis": {"$ref": "#/$defs/vec3"},
        "parameters": {"type": "object", "additionalProperties": {"type": ["number", "string", "boolean"]}}}},
    "attachment": {"description": "Untrusted geometric attachment claim; not accepted as a dimension equation until independently checked.",
      "type": "object", "additionalProperties": false, "required": ["geometry_ref", "selector"],
      "properties": {"geometry_ref": {"$ref": "#/$defs/geometry_ref"}, "selector": {"enum": ["point_on_geometry", "center", "axis", "start", "end", "surface"]},
        "point_mm": {"$ref": "#/$defs/vec3"}, "feature_id": {"type": "string"}}},
    "dimension": {"type": "object", "additionalProperties": false,
      "required": ["id", "view_id", "type", "value", "drawing_ref", "attachments", "measurement"],
      "properties": {"id": {"type": "string", "minLength": 1}, "view_id": {"type": "string", "minLength": 1},
        "type": {"enum": ["length", "signed_distance", "depth", "diameter", "radius", "angle"]}, "value": {"type": "number"},
        "drawing_ref": {"$ref": "#/$defs/drawing_ref"}, "attachments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/attachment"}},
        "measurement": {"type": "object", "additionalProperties": false, "required": ["kind"],
          "properties": {"kind": {"enum": ["true_length", "projected_length", "angle"]}, "direction_model": {"$ref": "#/$defs/vec3"}}},
        "reference": {"type": "boolean"}}},
    "structure": {"type": "object", "additionalProperties": false, "required": ["id", "view_id", "type", "value", "drawing_ref", "attachments"],
      "properties": {"id": {"type": "string", "minLength": 1}, "view_id": {"type": "string", "minLength": 1},
        "type": {"enum": ["symmetry", "alignment", "termination", "multiplicity", "equality", "structure_note"]},
        "value": {"type": ["string", "number", "boolean"]}, "drawing_ref": {"$ref": "#/$defs/drawing_ref"},
        "attachments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/attachment"}}}},
    "projection": {"type": "object", "additionalProperties": false, "required": ["type", "origin_mm", "right", "up", "normal"],
      "properties": {"type": {"const": "orthographic"}, "origin_mm": {"$ref": "#/$defs/vec3"},
        "right": {"$ref": "#/$defs/vec3"}, "up": {"$ref": "#/$defs/vec3"}, "normal": {"$ref": "#/$defs/vec3"}}},
    "sheet": {"type": "object", "additionalProperties": false, "required": ["origin_mm", "rotation_deg", "scale"],
      "properties": {"origin_mm": {"$ref": "#/$defs/vec2"}, "rotation_deg": {"type": "number"}, "scale": {"type": "number", "minimum": 0.000001, "maximum": 1000000}}},
    "geometry": {"type": "object", "additionalProperties": false, "required": ["visible", "hidden", "hidden_policy", "cut_edges", "hatches"],
      "properties": {"visible": {"allOf": [{"$ref": "#/$defs/refs"}, {"minItems": 1}]}, "hidden": {"$ref": "#/$defs/refs"},
        "hidden_policy": {"enum": ["omit", "all"]}, "cut_edges": {"$ref": "#/$defs/refs"}, "hatches": {"$ref": "#/$defs/refs"}}},
    "section": {"type": "object", "additionalProperties": false,
      "required": ["kind", "parent_view_id", "point_mm", "normal", "retained_side", "label", "markers"],
      "properties": {"kind": {"const": "planar_full"}, "parent_view_id": {"type": "string", "minLength": 1},
        "point_mm": {"$ref": "#/$defs/vec3"}, "normal": {"$ref": "#/$defs/vec3"}, "retained_side": {"enum": ["positive", "negative"]},
        "label": {"type": "string", "minLength": 1}, "markers": {"type": "object", "additionalProperties": false,
          "required": ["traces", "arrows", "labels", "title"], "properties": {"traces": {"allOf": [{"$ref": "#/$defs/refs"}, {"minItems": 1}]},
            "arrows": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object", "additionalProperties": false,
              "required": ["drawing_ref", "tip_vertex"], "properties": {"drawing_ref": {"$ref": "#/$defs/drawing_ref"}, "tip_vertex": {"type": "integer", "minimum": 0, "maximum": 2}}}},
            "labels": {"allOf": [{"$ref": "#/$defs/refs"}, {"minItems": 2, "maxItems": 2}]}, "title": {"$ref": "#/$defs/drawing_ref"}}}}},
    "view": {"type": "object", "additionalProperties": false, "required": ["id", "type", "projection", "sheet", "geometry"],
      "properties": {"id": {"type": "string", "minLength": 1}, "type": {"enum": ["orthographic", "full_section"]},
        "projection": {"$ref": "#/$defs/projection"}, "sheet": {"$ref": "#/$defs/sheet"}, "geometry": {"$ref": "#/$defs/geometry"}, "section": {"$ref": "#/$defs/section"}},
      "allOf": [{"if": {"properties": {"type": {"const": "full_section"}}}, "then": {"required": ["section"]}, "else": {"not": {"required": ["section"]}}}]}
  }
}
